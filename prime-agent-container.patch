diff -Naur a/packages/coding-agent/src/cli/container-config.ts b/packages/coding-agent/src/cli/container-config.ts
--- a/packages/coding-agent/src/cli/container-config.ts
+++ b/packages/coding-agent/src/cli/container-config.ts
@@ -0,0 +1,67 @@
+import { statSync } from "node:fs";
+import { isAbsolute, join } from "node:path";
+
+/**
+ * Container build: managed instructions and skills.
+ *
+ * A container image sets PRIME_AGENT_CONTAINER_CONFIG_DIR to a read-only
+ * directory outside the persistent agent state. Its `APPEND_SYSTEM.md` and
+ * `skills/` entries are prepended to the runtime config that every client
+ * derives from its CLI arguments, so they reach initial sessions, daemon
+ * defaults, worker creation/recovery, and subagents without touching public
+ * management commands. Managed entries come first; user entries keep the last
+ * word. When the variable is unset or relative, or an entry is missing or of
+ * the wrong type, the inputs are returned untouched and behavior is exactly
+ * upstream's.
+ */
+export const CONTAINER_CONFIG_DIR_ENV = "PRIME_AGENT_CONTAINER_CONFIG_DIR";
+export const CONTAINER_APPEND_SYSTEM_PROMPT_FILE = "APPEND_SYSTEM.md";
+export const CONTAINER_SKILLS_DIR = "skills";
+
+export function containerConfigDir(environment: NodeJS.ProcessEnv = process.env): string | undefined {
+	const value = environment[CONTAINER_CONFIG_DIR_ENV];
+	if (!value || !isAbsolute(value) || value.includes("\n")) {
+		return undefined;
+	}
+	return value;
+}
+
+function withContainerEntry(
+	values: string[] | undefined,
+	entryName: string,
+	kind: "file" | "directory",
+	environment: NodeJS.ProcessEnv,
+): string[] | undefined {
+	const dir = containerConfigDir(environment);
+	if (dir === undefined) {
+		return values;
+	}
+	const entry = join(dir, entryName);
+	let present: boolean;
+	try {
+		const stats = statSync(entry);
+		present = kind === "file" ? stats.isFile() : stats.isDirectory();
+	} catch {
+		present = false;
+	}
+	if (!present) {
+		return values;
+	}
+	return [entry, ...(values ?? []).filter((value) => value !== entry)];
+}
+
+/** Prepend the managed `APPEND_SYSTEM.md`, when present, to `--append-system-prompt` inputs. */
+export function withContainerAppendSystemPrompt(
+	appendSystemPrompt: string[] | undefined,
+	environment: NodeJS.ProcessEnv = process.env,
+): string[] | undefined {
+	return withContainerEntry(appendSystemPrompt, CONTAINER_APPEND_SYSTEM_PROMPT_FILE, "file", environment);
+}
+
+/** Prepend the managed `skills/` directory, when present, to explicit `--skill` inputs. */
+export function withContainerSkills(
+	skills: string[] | undefined,
+	environment: NodeJS.ProcessEnv = process.env,
+): string[] | undefined {
+	return withContainerEntry(skills, CONTAINER_SKILLS_DIR, "directory", environment);
+}
